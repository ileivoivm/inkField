{
  "cleanUrls": false,
  "trailingSlash": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "gallery/**/*.{html,js,css,json}",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "gallery/thumbs/**",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/tech",
      "destination": "/tech/index.html"
    },
    {
      "source": "/tech/",
      "destination": "/tech/index.html"
    },
    {
      "source": "/tech/en",
      "destination": "/tech/en/index.html"
    },
    {
      "source": "/tech/en/",
      "destination": "/tech/en/index.html"
    }
  ]
}